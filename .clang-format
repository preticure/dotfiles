
#        ________                       ______                          __
#       / ____/ /___ _____  ____ _     / ____/___  _________ ___  ____ _/ /_
#      / /   / / __ `/ __ \/ __ `/    / /_  / __ \/ ___/ __ `__ \/ __ `/ __/
#     / /___/ / /_/ / / / / /_/ /    / __/ / /_/ / /  / / / / / / /_/ / /_
#     \____/_/\__,_/_/ /_/\__, /    /_/    \____/_/  /_/ /_/ /_/\__,_/\__/
#                        /____/
#

Language: Cpp
ColumnLimit: 100

UseTab: Always
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4

AlignConsecutiveAssignments: Consecutive
AlignTrailingComments: true
AlwaysBreakBeforeMultilineStrings: true

FixNamespaceComments: true
NamespaceIndentation: All

InsertNewlineAtEOF: true

# ==============================
#         Break Style
# ==============================
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false
AllowShortBlocksOnASingleLine: Empty
AllowShortFunctionsOnASingleLine: Inline

# ==============================
#   Constructor Initialization 
# ==============================
#
#   Constructor()
#       : initializer1()
#       , initializer2()
#       , initializer3()
#
BreakConstructorInitializers: BeforeComma
ConstructorInitializerIndentWidth: 4
PackConstructorInitializers: Never

# ==============================
#      Function Parameters
# ==============================
#
#   void myFunction(int a,
#                   int b,
#                   int c,
#                   int d,
#                   int e);
#
#   callFunction(a,
#                b,
#                c,
#                d);
#
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
BinPackArguments: false
BinPackParameters: false

# ==============================
#    Braced Initializer Style
# ==============================
#
#   auto s = SomeStruct{
#     .foo = "foo",
#     .bar = "bar",
#     .baz = "baz",
#   };
#
AlignAfterOpenBracket: AlwaysBreak
BracedInitializerIndentWidth: 2
AlignArrayOfStructures: None
Cpp11BracedListStyle: true

# ==============================
#     Access Modifier Style
# ==============================
#
#   class Foo
#   {
#   public:
#       void bar();
#   private:
#       int mData;
#   };
#
AccessModifierOffset: -4
EmptyLineAfterAccessModifier: Never
EmptyLineBeforeAccessModifier: Never

# ==============================
#         Pointer Style
# ==============================
#
#   int* a;
#   int& b;
#
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Pointer

# ==============================
#         Operand Style
# ==============================
AlignOperands: Align
BreakBeforeBinaryOperators: None

# ==============================
#      Include Sort Order
# ==============================
#
#   1. Main Module Header
#   2. Local/Private Headers
#   3. LLVM project/subproject headers
#   4. External Headers
#   5. System #includes
#
SortIncludes:
  Enabled: true
  IgnoreCase: true
  IgnoreExtension: false
IncludeBlocks: Merge
IncludeCategories:
  - Regex:           '^"(lldb|llvm|clang)/'
    SortPriority:        2
  - Regex:           '^[<](glm|GL|SDL3|SDL3_image/stb)/'
    SortPriority:        3
  - Regex:           '^<[[:alnum:].]+>'
    SortPriority:        4
  - Regex:           '^"[^/]+'
    SortPriority:        1